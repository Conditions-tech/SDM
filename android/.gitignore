# Gradle and Android Studio
.gradle/
.kotlin/
build/
local.properties
.idea/
*.iml
captures/

# Signing keys never go into Git (ADR-0022): the release key is a GitHub secret.
*.jks
*.keystore
keystore.properties

# The root .gitignore's "downloads/" (SDM's runtime download folders) must not hide the app's
# `downloads` source package (found before the first push, 2026-11-23).
!app/src/**/downloads/
